#!/bin/sh
# Sourced by bin/<%= @release.name %> before every command (ADR-0021).
#
# `mix release` writes a cookie into releases/COOKIE, and a deployed release leaves it
# mode 0644 under /opt/goodmao2 (0755) — readable by every account on the host, including
# the co-hosted app's. A cookie is the only thing Erlang distribution checks, so whoever
# reads it can run any code as this app. Distribution therefore runs only with a cookie
# the server provides (RELEASE_COOKIE; Ansible generates one per server), and only on
# 127.0.0.1.

# A fixed node name on the loopback address, so `remote` and `rpc` reach the node on
# 127.0.0.1 whatever the host name resolves to.
RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
export RELEASE_DISTRIBUTION
RELEASE_NODE="${RELEASE_NODE:-<%= @release.name %>@127.0.0.1}"
export RELEASE_NODE

# An epmd this release starts listens on loopback only. (vm.args and remote.vm.args bind
# the distribution port itself to 127.0.0.1.)
ERL_EPMD_ADDRESS="${ERL_EPMD_ADDRESS:-127.0.0.1}"
export ERL_EPMD_ADDRESS

# Every command that joins the distribution needs a cookie of the server's own. `eval`
# and `version` start no distribution and need none, so `bin/migrate` is unaffected.
case $RELEASE_COMMAND in
  start | start_iex | daemon | daemon_iex | remote | rpc | restart | stop | pid)
    if [ "$RELEASE_DISTRIBUTION" != none ]; then
      release_file_cookie="$(cat "$RELEASE_ROOT/releases/COOKIE" 2>/dev/null || true)"

      if [ -z "${RELEASE_COOKIE:-}" ] || [ "$RELEASE_COOKIE" = "$release_file_cookie" ]; then
        echo "ERROR: RELEASE_COOKIE must be set to this server's own secret cookie." >&2
        echo "The cookie in releases/COOKIE is readable by other accounts on the host and is not a secret." >&2
        echo "Set RELEASE_COOKIE in the environment file (Ansible generates one per server)," >&2
        echo "or set RELEASE_DISTRIBUTION=none to run without Erlang distribution." >&2
        exit 1
      fi
    fi
    ;;
esac
